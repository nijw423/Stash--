name: Codex Routing - 2026.11.18
desc: Persistent routing for AI, video, finance, Amazon, and mobile games.

proxy-groups:
  - name: CODEX-AI
    type: select
    proxies:
      - "🇺🇸美国凤凰城专线-0.1倍率"
      - "🇺🇸美国4号-0.1倍率"
      - "🇺🇸美国凤凰城专线4-0.1倍率"
      - "🇺🇸美国ai解锁"

  - name: CODEX-YOUTUBE
    type: url-test
    proxies:
      - "🇯🇵日本专线-0.1倍率"
      - "🇯🇵日本专线2-0.1倍率"
      - "🇯🇵日本专线3-0.1倍率"
      - "🇯🇵日本专线4-0.1倍率"
      - "🇯🇵日本专线5-0.1倍率"
      - "🇯🇵日本专线6-0.1倍率"
      - "🇺🇸美国凤凰城专线-0.1倍率"
      - "🇺🇸美国凤凰城专线2-0.1倍率"
      - "🇺🇸美国ai解锁-0.1倍率"
    url: https://www.youtube.com/generate_204
    interval: 300
    tolerance: 80

  - name: CODEX-FIN-HK
    type: select
    proxies:
      - "🇭🇰香港HKBN"
      - "🇭🇰香港HKBN2"
      - "🇭🇰香港家宽专线"

  - name: CODEX-FIN-SG
    type: select
    proxies:
      - "🇸🇬新加坡专线"
      - "🇸🇬新加坡专线2"
      - "🇸🇬新加坡专线3"

  - name: CODEX-FIN-US
    type: select
    proxies:
      - "🇺🇸美国凤凰城专线-0.1倍率"
      - "🇺🇸美国凤凰城专线2-0.1倍率"
      - "🇺🇸美国凤凰城专线3-0.1倍率"

  - name: CODEX-AMAZON-US
    type: select
    proxies:
      - "🇺🇸美国凤凰城专线-0.1倍率"
      - "🇺🇸美国2号-0.01倍率"
      - "🇺🇸美国凤凰城专线4-0.1倍率"
      - "🇺🇸美国4号-0.1倍率"

  - name: CODEX-GAME
    type: url-test
    proxies:
      - "🇯🇵日本专线-0.1倍率"
      - "🇯🇵日本专线2-0.1倍率"
      - "🇯🇵日本专线3-0.1倍率"
      - "🇸🇬新加坡专线"
      - "🇸🇬新加坡专线2"
      - "🇸🇬新加坡专线3"
      - "🇺🇸美国凤凰城专线-0.1倍率"
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 80

